-- == Movement Update Loop (Heartbeat) == (No changes needed here for new commands)
local function updateMovement(deltaTime) if not LocalCharacter or not LocalHumanoid or not LocalRootPart or LocalHumanoid.Health<=0 then if isFollowing or isFlying or isOrbiting or isBanging or isSpinning then stopAllMovement() end; return end; local movementTarget=currentMovementTargetPlayer or TargetPlayer; local bangTarget=currentBangTargetPlayer; local effectiveTarget=nil; if isFollowing or isFlying or isOrbiting then effectiveTarget=movementTarget elseif isBanging then effectiveTarget=bangTarget elseif isSpinning then effectiveTarget=nil end; local targetCharacter=effectiveTarget and effectiveTarget.Character; local targetRootPart=targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart"); local targetHumanoid=targetCharacter and targetCharacter:FindFirstChild("Humanoid"); if (isFollowing or isFlying or isOrbiting or isBanging) and not (effectiveTarget and targetCharacter and targetRootPart and targetHumanoid and targetHumanoid.Health>0) then print("Stopping movement/effect (Target '"..(effectiveTarget and effectiveTarget.Name or "nil").."' invalid/died)."); stopAllMovement(); return end; if isFollowing then if (LocalRootPart.Position-targetRootPart.Position).Magnitude>MIN_FOLLOW_DISTANCE then LocalHumanoid:MoveTo(targetRootPart.Position) end end; local moversValid=bodyPos and bodyGyro and bodyPos.Parent and bodyGyro.Parent; if (isFlying or isOrbiting) and not moversValid then print("Body movers missing/invalid, stopping."); stopAllMovement(); return end; if isFlying then local tl=targetRootPart.CFrame.LookVector; local o=tl*-FLY_BEHIND_DISTANCE; local dp=targetRootPart.Position+o+Vector3.new(0,FLY_HEIGHT_OFFSET,0); bodyPos.Position=dp; if (targetRootPart.Position-LocalRootPart.Position).Magnitude>0.1 then bodyGyro.CFrame=CFrame.lookAt(LocalRootPart.Position, targetRootPart.Position) end; if not LocalHumanoid.PlatformStand then LocalHumanoid.PlatformStand=true end end; if isOrbiting then currentOrbitAngle=(currentOrbitAngle+ORBIT_SPEED*deltaTime)%(2*math.pi); local xo=math.cos(currentOrbitAngle)*ORBIT_RADIUS; local zo=math.sin(currentOrbitAngle)*ORBIT_RADIUS; local dp=targetRootPart.Position+Vector3.new(xo,ORBIT_HEIGHT_OFFSET,zo); bodyPos.Position=dp; if (targetRootPart.Position-LocalRootPart.Position).Magnitude>0.1 then bodyGyro.CFrame=CFrame.lookAt(LocalRootPart.Position, targetRootPart.Position) end; if not LocalHumanoid.PlatformStand then LocalHumanoid.PlatformStand=true end end; if isBanging then local desiredCFrame=targetRootPart.CFrame*BANG_OFFSET; LocalRootPart.CFrame=desiredCFrame; if LocalHumanoid and not LocalHumanoid.PlatformStand then LocalHumanoid.PlatformStand=true end end end

-- == Chat Processing == (Added new commands)
local function onPlayerChatted(speaker, message)
    if not (speaker and speaker.Name == TARGET_USERNAME) then return end
    local trimmedMessage=message:match("^%s*(.-)%s*$"); if not trimmedMessage then return end; local lowerMessage=string.lower(trimmedMessage); local commandPart=nil; local argumentPart=nil; local commandFound=false
    local function checkCommand(cmdStr,baseCmdConst) local p=cmdStr.." "; if lowerMessage==cmdStr or lowerMessage:sub(1,#p)==p then commandPart=baseCmdConst; if lowerMessage:sub(1,#p)==p then argumentPart=trimmedMessage:sub(#p):match("^%s*(.-)%s*$") end; return true end; return false end
    local function checkPrefixCommand(cmdStrNoDot,baseCmdConst) local p1="/e "..cmdStrNoDot; local p1s=p1.." "; local p2="/e ."..cmdStrNoDot; local p2s=p2.." "; if lowerMessage==p1 or lowerMessage:sub(1,#p1s)==p1s then commandPart=baseCmdConst; if lowerMessage:sub(1,#p1s)==p1s then argumentPart=trimmedMessage:sub(#p1s):match("^%s*(.-)%s*$") end; return true end; if lowerMessage==p2 or lowerMessage:sub(1,#p2s)==p2s then commandPart=baseCmdConst; if lowerMessage:sub(1,#p2s)==p2s then argumentPart=trimmedMessage:sub(#p2s):match("^%s*(.-)%s*$") end; return true end; return false end

    -- Check commands
    if checkCommand(GOTO_COMMAND, GOTO_COMMAND) then commandFound=true
    elseif checkCommand(FOLLOW_COMMAND, FOLLOW_COMMAND) then commandFound=true
    elseif checkCommand(FLY_COMMAND, FLY_COMMAND) then commandFound=true
    elseif checkCommand(ORBIT_COMMAND, ORBIT_COMMAND) then commandFound=true
    elseif checkCommand(BANG_COMMAND, BANG_COMMAND) then commandFound=true
    elseif checkCommand(UNFOLLOW_COMMAND, UNFOLLOW_COMMAND) then commandFound=true
    elseif checkCommand(UNFLY_COMMAND, UNFLY_COMMAND) then commandFound=true
    elseif checkCommand(SPEED_COMMAND, SPEED_COMMAND) then commandFound=true
    elseif checkCommand(JUMP_COMMAND, JUMP_COMMAND) then commandFound=true
