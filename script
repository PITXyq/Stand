-- == Player Finding Function (Partial Name Matching) ==
local function findPlayerByPartialName(partialName)
    if not partialName or partialName == "" then return nil, "No name provided." end
    local lowerPartialName = string.lower(partialName); local matches = {};
    for _, player in ipairs(Players:GetPlayers()) do if player ~= LocalPlayer then local lowerPlayerName = string.lower(player.Name); if lowerPlayerName:sub(1, #lowerPartialName) == lowerPartialName then table.insert(matches, player) end end end
    if #matches == 1 then return matches[1], nil elseif #matches == 0 then return nil, "Player starting with '" .. partialName .. "' not found." else local nameList = {}; for _, p in ipairs(matches) do table.insert(nameList, p.Name) end; return nil, "Multiple players found: " .. table.concat(nameList, ", ") .. ". Be more specific." end
end

-- == Noclip Functions ==
local function setCharacterCollision(character, canCollide) if not character then return end; for _, p in ipairs(character:GetDescendants()) do if p:IsA("BasePart") then p.CanCollide = canCollide end end end
local function enableNoclip(character) print("Stand Script: Enabling Noclip."); setCharacterCollision(character, false) end
local function disableNoclip(character) print("Stand Script: Disabling Noclip."); setCharacterCollision(character, true) end

-- == Animation Functions ==
local function performStopAnimation() if currentAnimTrack then print("Stopping custom anim."); currentAnimTrack:Stop(); currentAnimTrack = nil end; if currentBangAnimTrack then print("Stopping bang anim."); currentBangAnimTrack:Stop(); currentBangAnimTrack = nil end end
local function performPlayAnimation(animId) if not LocalAnimator then print("Animator not found."); return end; local idNum = tonumber(animId); if not idNum then print("Invalid anim ID:", animId); return end; stopAllMovement(); local a=Instance.new("Animation"); a.AnimationId="rbxassetid://"..idNum; currentAnimTrack=LocalAnimator:LoadAnimation(a); if currentAnimTrack then print("Playing anim ID:", idNum); currentAnimTrack:Play(); currentAnimTrack.Looped = true else print("Failed to load anim.") end; a:Destroy() end
local function playBangAnimation() if not LocalAnimator then return end; performStopAnimation(); local a=Instance.new("Animation"); a.AnimationId="rbxassetid://"..BANG_ANIM_ID; currentBangAnimTrack=LocalAnimator:LoadAnimation(a); if currentBangAnimTrack then currentBangAnimTrack:Play(0.1, 1, 3); currentBangAnimTrack.Looped=true end; a:Destroy() end

-- == Cleanup / Stopping Functions ==
local function destroyBodyMovers() if bodyPos then bodyPos:Destroy(); bodyPos=nil end; if bodyGyro then bodyGyro:Destroy(); bodyGyro=nil end; if spinVelocity then spinVelocity:Destroy(); spinVelocity=nil end; if LocalHumanoid and LocalHumanoid.Health>0 then LocalHumanoid.PlatformStand=false end end -- Added spinVelocity cleanup
local function stopFlying() if not isFlying then return end; print("Stopping fly."); isFlying=false; disableNoclip(LocalCharacter) end
local function stopOrbiting() if not isOrbiting then return end; print("Stopping orbit."); isOrbiting=false end
local function stopFollowing() if not isFollowing then return end; print("Stopping ground follow."); isFollowing=false; if LocalHumanoid and LocalRootPart and LocalHumanoid.Health>0 then LocalHumanoid:MoveTo(LocalRootPart.Position) end end
local function stopBang() if not isBanging then return end; print("Stopping bang effect."); isBanging=false; currentBangTargetPlayer=nil; if currentBangAnimTrack then currentBangAnimTrack:Stop(); currentBangAnimTrack=nil end; if LocalHumanoid then LocalHumanoid.PlatformStand=false end end
local function stopSpin() -- NEW
    if not isSpinning then return end; print("Stopping spin.")
    isSpinning = false
    if spinVelocity then spinVelocity:Destroy(); spinVelocity = nil end
end
local function stopAllMovement() -- Modified to include spin
    local stopped = isFollowing or isFlying or isOrbiting or isBanging or isSpinning or currentAnimTrack;
    if isFollowing then stopFollowing() end
    if isFlying then stopFlying() end
    if isOrbiting then stopOrbiting() end
    if isBanging then stopBang() end
    if isSpinning then stopSpin() end -- NEW: Stop spin
    if not isFlying and not isOrbiting and not isSpinning then destroyBodyMovers() end -- Destroy movers only if fly/orbit/spin off
    if currentAnimTrack or currentBangAnimTrack then performStopAnimation() end -- Handles custom and bang anims
    currentMovementTargetPlayer = nil; currentBangTargetPlayer = nil; -- Clear targets
    if stopped then print("Stand Script: All movement modes/animations stopped.") end
end

