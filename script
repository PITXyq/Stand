    elseif checkPrefixCommand("bang", BANG_COMMAND) then commandFound=true
    elseif checkPrefixCommand("unfollow", UNFOLLOW_COMMAND) then commandFound=true
    elseif checkPrefixCommand("unfly", UNFLY_COMMAND) then commandFound=true
    elseif checkPrefixCommand("speed", SPEED_COMMAND) then commandFound=true
