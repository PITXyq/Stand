    elseif checkCommand(SPIN_COMMAND, SPIN_COMMAND) then commandFound=true -- NEW
    elseif checkCommand(PLATFORMSTAND_COMMAND, PLATFORMSTAND_COMMAND) then commandFound=true -- NEW
    elseif checkCommand(SITWALK_COMMAND, SITWALK_COMMAND) then commandFound=true -- NEW
    elseif checkPrefixCommand("goto", GOTO_COMMAND) then commandFound=true
    elseif checkPrefixCommand("follow", FOLLOW_COMMAND) then commandFound=true
    elseif checkPrefixCommand("fly", FLY_COMMAND) then commandFound=true
