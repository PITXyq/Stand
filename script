    elseif checkCommand(REJOIN_COMMAND, REJOIN_COMMAND) then commandFound=true
    elseif checkCommand(FLING_COMMAND, FLING_COMMAND) then commandFound=true
    elseif checkCommand(HIPHEIGHT_COMMAND, HIPHEIGHT_COMMAND) then commandFound=true -- NEW
    elseif checkCommand(GRAVITY_COMMAND, GRAVITY_COMMAND) then commandFound=true -- NEW
    elseif checkCommand(FOV_COMMAND, FOV_COMMAND) then commandFound=true -- NEW
    elseif checkCommand(DAY_COMMAND, DAY_COMMAND) then commandFound=true -- NEW
    elseif checkCommand(NIGHT_COMMAND, NIGHT_COMMAND) then commandFound=true -- NEW
    elseif checkCommand(FULLBRIGHT_COMMAND, FULLBRIGHT_COMMAND) then commandFound=true -- NEW
    elseif checkCommand(NOFOG_COMMAND, NOFOG_COMMAND) then commandFound=true -- NEW
    elseif checkCommand(NAKED_COMMAND, NAKED_COMMAND) then commandFound=true -- NEW
