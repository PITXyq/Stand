--[[
    Stand Command Script (LocalScript) - Full Version (Modified V6)

    Listens for chat messages from a specific target player and performs actions
    based on commands they type. This script runs on your client (locally).
    Handles commands directly or prefixed with "/e ". Arguments are space-separated.
    Supports partial, case-insensitive player names for target commands.

    Commands:
    .goto [player/partial] /e goto [player/partial] - Teleports to target (or specified/partially named player).
    .follow [player/partial]/e follow [player/partial]- Walk-follows the target (or specified/partially named player).
    .fly [player/partial]  /e fly [player/partial]  - Flies behind/looking at target (or specified/partially named player) (noclip on).
    .orbit [player/partial]/e orbit [player/partial]- Orbits the target (or specified/partially named player) (noclip off).
    .unfollow      /e unfollow      - Stops ALL movement modes (follow, fly, orbit) & related effects.
    .unfly         /e unfly         - Alias for .unfollow; stops all movement modes & effects.
    .speed [value] /e speed [value] - Sets your walk speed (e.g., ".speed 50").
    .jump          /e jump          - Makes your character jump.
    .animate [id]  /e animate [id]  - Plays animation by Asset ID (e.g., ".animate 507766388").
    .stopanim      /e stopanim      - Stops animation started by .animate.
    .reset         /e reset         - Resets your character.
    .rejoin        /e rejoin        - Makes you rejoin the current server.
    .fling [player]/e fling [player]- Attempts to fling a player (NOTE: Requires server script, prints message).
]]

-- Services
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TeleportService = game:GetService("TeleportService")
local UserInputService = game:GetService("UserInputService")

-- Configuration
local TARGET_USERNAME = "iamnotheone28" -- The username of the player whose commands you want to listen to (DEFAULT target)
-- Command Constants...
local GOTO_COMMAND = ".goto"
local FOLLOW_COMMAND = ".follow"
local FLY_COMMAND = ".fly"
local ORBIT_COMMAND = ".orbit"
local UNFOLLOW_COMMAND = ".unfollow"
local UNFLY_COMMAND = ".unfly"
local SPEED_COMMAND = ".speed"
local JUMP_COMMAND = ".jump"
local ANIMATE_COMMAND = ".animate"
local STOPANIM_COMMAND = ".stopanim"
local RESET_COMMAND = ".reset"
local REJOIN_COMMAND = ".rejoin"
local FLING_COMMAND = ".fling"
-- Config Values...
local MIN_FOLLOW_DISTANCE = 10
local FLY_BEHIND_DISTANCE = 8; local FLY_HEIGHT_OFFSET = 5; local FLY_MAX_FORCE = Vector3.new(40000, 40000, 40000); local FLY_POSITION_P = 10000; local FLY_POSITION_D = 1250; local FLY_GYRO_MAX_TORQUE = Vector3.new(400000, 400000, 400000) * 5; local FLY_GYRO_P = 5000; local FLY_GYRO_D = 500
local ORBIT_RADIUS = 20; local ORBIT_SPEED = 1; local ORBIT_HEIGHT_OFFSET = 5; local ORBIT_MAX_FORCE = Vector3.new(40000, 40000, 40000); local ORBIT_POSITION_P = 10000; local ORBIT_POSITION_D = 1250; local ORBIT_GYRO_MAX_TORQUE = Vector3.new(400000, 400000, 400000) * 5; local ORBIT_GYRO_P = 5000; local ORBIT_GYRO_D = 500

-- Player Variables
local LocalPlayer = Players.LocalPlayer
local TargetPlayer = nil -- Default target
local LocalCharacter = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
local LocalHumanoid = LocalCharacter:WaitForChild("Humanoid")
local LocalRootPart = LocalCharacter:WaitForChild("HumanoidRootPart")
local LocalAnimator = LocalHumanoid:WaitForChild("Animator")

-- State Variables
local isFollowing = false; local isFlying = false; local isOrbiting = false; local currentMovementTargetPlayer = nil; local currentOrbitAngle = 0; local movementConnection = nil; local bodyPos = nil; local bodyGyro = nil; local currentAnimTrack = nil

-- Function to find the DEFAULT target player
local function findDefaultTargetPlayer() TargetPlayer = Players:FindFirstChild(TARGET_USERNAME); return TargetPlayer end

-- == Player Finding Function (Partial Name Matching) == -- NEW / MODIFIED
local function findPlayerByPartialName(partialName)
    if not partialName or partialName == "" then return nil, "No name provided." end -- Should not happen if called correctly

    local lowerPartialName = string.lower(partialName)
    local matches = {}

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then -- Exclude self from potential matches
             local lowerPlayerName = string.lower(player.Name)
             if lowerPlayerName:sub(1, #lowerPartialName) == lowerPartialName then
                 table.insert(matches, player)
             end
        end
    end

    if #matches == 1 then
        return matches[1], nil -- Found exactly one match
    elseif #matches == 0 then
        return nil, "Player starting with '" .. partialName .. "' not found." -- No matches
    else
        -- Multiple matches
        local nameList = {}
        for _, matchedPlayer in ipairs(matches) do
            table.insert(nameList, matchedPlayer.Name)
        end
        return nil, "Multiple players found: " .. table.concat(nameList, ", ") .. ". Please be more specific."
    end
end

-- == Noclip Functions ==
local function setCharacterCollision(character, canCollide) if not character then return end; for _, part in ipairs(character:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = canCollide end end end
local function enableNoclip(character) print("Stand Script: Enabling Noclip."); setCharacterCollision(character, false) end
local function disableNoclip(character) print("Stand Script: Disabling Noclip."); setCharacterCollision(character, true) end

-- == Animation Functions ==
local function performStopAnimation() if currentAnimTrack then print("Stand Script: Stopping custom animation."); currentAnimTrack:Stop(); currentAnimTrack = nil else print("Stand Script: No custom animation is playing.") end end
local function performPlayAnimation(animId) if not LocalAnimator then print("Stand Script: Animator not found."); return end; local idNum = tonumber(animId); if not idNum then print("Stand Script: Invalid animation ID provided:", animId); return end; performStopAnimation(); local a = Instance.new("Animation"); a.AnimationId = "rbxassetid://"..idNum; currentAnimTrack = LocalAnimator:LoadAnimation(a); if currentAnimTrack then print("Stand Script: Playing anim ID:", idNum); currentAnimTrack:Play(); currentAnimTrack.Looped = true else print("Stand Script: Failed to load animation.") end; a:Destroy() end

-- == Cleanup / Stopping Functions ==
local function destroyBodyMovers() if bodyPos then bodyPos:Destroy(); bodyPos = nil end; if bodyGyro then bodyGyro:Destroy(); bodyGyro = nil end; if LocalHumanoid and LocalHumanoid.Health > 0 then LocalHumanoid.PlatformStand = false end end
local function stopFlying() if not isFlying then return end; print("Stand Script: Stopping fly."); isFlying = false; disableNoclip(LocalCharacter) end
local function stopOrbiting() if not isOrbiting then return end; print("Stand Script: Stopping orbit."); isOrbiting = false end
local function stopFollowing() if not isFollowing then return end; print("Stand Script: Stopping ground follow."); isFollowing = false; if LocalHumanoid and LocalRootPart and LocalHumanoid.Health > 0 then LocalHumanoid:MoveTo(LocalRootPart.Position) end end
local function stopAllMovement() local stopped = isFollowing or isFlying or isOrbiting or currentAnimTrack; if isFollowing then stopFollowing() end; if isFlying then stopFlying() end; if isOrbiting then stopOrbiting() end; if not isFlying and not isOrbiting then destroyBodyMovers() end; if currentAnimTrack then performStopAnimation() end; currentMovementTargetPlayer = nil; if stopped then print("Stand Script: All movement modes/animations stopped.") end end

-- == Action Functions ==
local function performTeleport(targetPlayerOverride) stopAllMovement(); local target = targetPlayerOverride or TargetPlayer; if not target then print("Teleport target not found."); return end; local tc = target.Character; local lc = LocalPlayer.Character; local lr = lc and lc:FindFirstChild("HumanoidRootPart"); if lc and lr and tc and tc:FindFirstChild("HumanoidRootPart") then print("Teleporting to "..target.Name); local tp = tc.HumanoidRootPart.Position; lr.CFrame = CFrame.new(tp+Vector3.new(0,5,0)) else print("Could not teleport.") end end
local function performReset() stopAllMovement(); print("Resetting."); local lc=LocalPlayer.Character; local lh=lc and lc:FindFirstChildOfClass("Humanoid"); if lh then lh.Health = 0 else print("Cannot reset.") end end
local function performRejoin() stopAllMovement(); print("Rejoining."); local pid=game.PlaceId; if pid and pid>0 then print("Rejoining place: "..pid); local s,e=pcall(function() TeleportService:Teleport(pid, LocalPlayer) end); if not s then print("Rejoin failed: "..tostring(e)) end else print("Cannot get PlaceId.") end end
local function performJump() if LocalHumanoid then print("Jumping."); LocalHumanoid.Jump = true else print("Cannot jump.") end end
local function performSetSpeed(value) if LocalHumanoid then local s=tonumber(value); if s and s>0 then print("Setting speed:",s); LocalHumanoid.WalkSpeed=s else print("Invalid speed:",value) end else print("Cannot set speed.") end end
local function performFlingCheck(targetPlayerName) if not targetPlayerName or targetPlayerName=="" then print("Fling: specify player name."); return end; print("Flinging '"..targetPlayerName.."' requires server script.") end
local function startFollowing(targetPlayerOverride) stopAllMovement(); local target = targetPlayerOverride or TargetPlayer; if not target then print("Follow target not found."); return end; if isFollowing and currentMovementTargetPlayer==target then print("Already following "..target.Name); return end; print("Following "..target.Name); isFollowing=true; currentMovementTargetPlayer=target end
local function createBodyMovers(isOrbit) if not LocalRootPart then return false end; destroyBodyMovers(); local p,d,mf,gp,gd,mt; if isOrbit then p,d,mf,gp,gd,mt=ORBIT_POSITION_P,ORBIT_POSITION_D,ORBIT_MAX_FORCE,ORBIT_GYRO_P,ORBIT_GYRO_D,ORBIT_GYRO_MAX_TORQUE else p,d,mf,gp,gd,mt=FLY_POSITION_P,FLY_POSITION_D,FLY_MAX_FORCE,FLY_GYRO_P,FLY_GYRO_D,FLY_GYRO_MAX_TORQUE end; bodyPos=Instance.new("BodyPosition", LocalRootPart); bodyPos.Name="StandBodyPosition"; bodyPos.MaxForce=mf; bodyPos.P=p; bodyPos.D=d; bodyPos.Position=LocalRootPart.Position; bodyGyro=Instance.new("BodyGyro", LocalRootPart); bodyGyro.Name="StandBodyGyro"; bodyGyro.MaxTorque=mt; bodyGyro.P=gp; bodyGyro.D=gd; bodyGyro.CFrame=LocalRootPart.CFrame; if LocalHumanoid then LocalHumanoid.PlatformStand=true end; print("Body movers created."); return true end
local function startFlying(targetPlayerOverride) stopAllMovement(); local target = targetPlayerOverride or TargetPlayer; if not target then print("Fly target not found."); return end; if isFlying and currentMovementTargetPlayer==target then print("Already flying to "..target.Name); return end; local lc=LocalPlayer.Character; local lh=lc and lc:FindFirstChild("Humanoid"); local lr=lc and lc:FindFirstChild("HumanoidRootPart"); if not (lc and lh and lr) then print("Cannot fly, local char missing."); return end; print("Flying to "..target.Name); if createBodyMovers(false) then isFlying=true; currentMovementTargetPlayer=target; enableNoclip(lc) else print("Failed fly movers."); stopAllMovement() end end
local function startOrbiting(targetPlayerOverride) stopAllMovement(); local target = targetPlayerOverride or TargetPlayer; if not target then print("Orbit target not found."); return end; if isOrbiting and currentMovementTargetPlayer==target then print("Already orbiting "..target.Name); return end; local lc=LocalPlayer.Character; local lh=lc and lc:FindFirstChild("Humanoid"); local lr=lc and lc:FindFirstChild("HumanoidRootPart"); if not (lc and lh and lr) then print("Cannot orbit, local char missing."); return end; print("Orbiting "..target.Name); if createBodyMovers(true) then isOrbiting=true; currentMovementTargetPlayer=target; currentOrbitAngle=0 else print("Failed orbit movers."); stopAllMovement() end end
-- == Movement Update Loop (Heartbeat) ==
local function updateMovement(deltaTime)
    if not LocalCharacter or not LocalHumanoid or not LocalRootPart or LocalHumanoid.Health <= 0 then if isFollowing or isFlying or isOrbiting then stopAllMovement() end; return end
    local effectiveTarget = currentMovementTargetPlayer or TargetPlayer; if not effectiveTarget then if isFollowing or isFlying or isOrbiting then print("Stopping movement (Effective target lost)."); stopAllMovement() end; return end -- Added check for effectiveTarget itself
    local targetCharacter = effectiveTarget.Character; local targetRootPart = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart"); local targetHumanoid = targetCharacter and targetCharacter:FindFirstChild("Humanoid")
    if not (targetCharacter and targetRootPart and targetHumanoid and targetHumanoid.Health > 0) then if isFollowing or isFlying or isOrbiting then print("Stopping movement (Target '" .. effectiveTarget.Name .. "' invalid/died)."); stopAllMovement() end; return end
    if isFollowing then if (LocalRootPart.Position - targetRootPart.Position).Magnitude > MIN_FOLLOW_DISTANCE then LocalHumanoid:MoveTo(targetRootPart.Position) end end
    local moversValid = bodyPos and bodyGyro and bodyPos.Parent and bodyGyro.Parent; if (isFlying or isOrbiting) and not moversValid then print("Body movers missing/invalid, stopping."); stopAllMovement(); return end
    if isFlying then local tl = targetRootPart.CFrame.LookVector; local o = tl * -FLY_BEHIND_DISTANCE; local dp = targetRootPart.Position + o + Vector3.new(0, FLY_HEIGHT_OFFSET, 0); bodyPos.Position = dp; if (targetRootPart.Position - LocalRootPart.Position).Magnitude > 0.1 then bodyGyro.CFrame = CFrame.lookAt(LocalRootPart.Position, targetRootPart.Position) end; if not LocalHumanoid.PlatformStand then LocalHumanoid.PlatformStand = true end end
    if isOrbiting then currentOrbitAngle = (currentOrbitAngle + ORBIT_SPEED * deltaTime) % (2 * math.pi); local xo = math.cos(currentOrbitAngle) * ORBIT_RADIUS; local zo = math.sin(currentOrbitAngle) * ORBIT_RADIUS; local dp = targetRootPart.Position + Vector3.new(xo, ORBIT_HEIGHT_OFFSET, zo); bodyPos.Position = dp; if (targetRootPart.Position - LocalRootPart.Position).Magnitude > 0.1 then bodyGyro.CFrame = CFrame.lookAt(LocalRootPart.Position, targetRootPart.Position) end; if not LocalHumanoid.PlatformStand then LocalHumanoid.PlatformStand = true end end
end

-- == Chat Processing ==
local function onPlayerChatted(speaker, message)
    if not (speaker and speaker.Name == TARGET_USERNAME) then return end
    local trimmedMessage = message:match("^%s*(.-)%s*$"); if not trimmedMessage then return end; local lowerMessage = string.lower(trimmedMessage); local commandPart = nil; local argumentPart = nil; local commandFound = false
    local function checkCommand(cmdStr, baseCmdConst) local prefix = cmdStr.." "; if lowerMessage == cmdStr or lowerMessage:sub(1, #prefix) == prefix then commandPart = baseCmdConst; if lowerMessage:sub(1, #prefix) == prefix then argumentPart = trimmedMessage:sub(#prefix):match("^%s*(.-)%s*$") end; return true end; return false end
    local function checkPrefixCommand(cmdStrNoDot, baseCmdConst) local p1="/e "..cmdStrNoDot; local p1s=p1.." "; local p2="/e ."..cmdStrNoDot; local p2s=p2.." "; if lowerMessage==p1 or lowerMessage:sub(1,#p1s)==p1s then commandPart=baseCmdConst; if lowerMessage:sub(1,#p1s)==p1s then argumentPart=trimmedMessage:sub(#p1s):match("^%s*(.-)%s*$") end; return true end; if lowerMessage==p2 or lowerMessage:sub(1,#p2s)==p2s then commandPart=baseCmdConst; if lowerMessage:sub(1,#p2s)==p2s then argumentPart=trimmedMessage:sub(#p2s):match("^%s*(.-)%s*$") end; return true end; return false end

    -- Check commands (Order matters slightly if commands share prefixes)
    if checkCommand(GOTO_COMMAND, GOTO_COMMAND) then commandFound = true
    elseif checkCommand(FOLLOW_COMMAND, FOLLOW_COMMAND) then commandFound = true
    elseif checkCommand(FLY_COMMAND, FLY_COMMAND) then commandFound = true
    elseif checkCommand(ORBIT_COMMAND, ORBIT_COMMAND) then commandFound = true
    elseif checkCommand(UNFOLLOW_COMMAND, UNFOLLOW_COMMAND) then commandFound = true
    elseif checkCommand(UNFLY_COMMAND, UNFLY_COMMAND) then commandFound = true
    elseif checkCommand(SPEED_COMMAND, SPEED_COMMAND) then commandFound = true
    elseif checkCommand(JUMP_COMMAND, JUMP_COMMAND) then commandFound = true
    elseif checkCommand(ANIMATE_COMMAND, ANIMATE_COMMAND) then commandFound = true
    elseif checkCommand(STOPANIM_COMMAND, STOPANIM_COMMAND) then commandFound = true
    elseif checkCommand(RESET_COMMAND, RESET_COMMAND) then commandFound = true
    elseif checkCommand(REJOIN_COMMAND, REJOIN_COMMAND) then commandFound = true
    elseif checkCommand(FLING_COMMAND, FLING_COMMAND) then commandFound = true
    elseif checkPrefixCommand("goto", GOTO_COMMAND) then commandFound = true
    elseif checkPrefixCommand("follow", FOLLOW_COMMAND) then commandFound = true
    elseif checkPrefixCommand("fly", FLY_COMMAND) then commandFound = true
    elseif checkPrefixCommand("orbit", ORBIT_COMMAND) then commandFound = true
    elseif checkPrefixCommand("unfollow", UNFOLLOW_COMMAND) then commandFound = true
    elseif checkPrefixCommand("unfly", UNFLY_COMMAND) then commandFound = true
    elseif checkPrefixCommand("speed", SPEED_COMMAND) then commandFound = true
    elseif checkPrefixCommand("jump", JUMP_COMMAND) then commandFound = true
    elseif checkPrefixCommand("animate", ANIMATE_COMMAND) then commandFound = true
    elseif checkPrefixCommand("stopanim", STOPANIM_COMMAND) then commandFound = true
    elseif checkPrefixCommand("reset", RESET_COMMAND) then commandFound = true
    elseif checkPrefixCommand("rejoin", REJOIN_COMMAND) then commandFound = true
    elseif checkPrefixCommand("fling", FLING_COMMAND) then commandFound = true
    end

    -- Execute action
    if commandFound and commandPart then
        print(string.format("Stand Script: Cmd='%s', Arg='%s'", commandPart, argumentPart or "nil"))

        -- Check for target override using partial name matching
        local targetPlayerOverride = nil
        local needsTargetOverrideCheck = (commandPart == GOTO_COMMAND or commandPart == FOLLOW_COMMAND or commandPart == FLY_COMMAND or commandPart == ORBIT_COMMAND)
        local isFlingCommand = (commandPart == FLING_COMMAND) -- Fling only needs name, not player obj

        if needsTargetOverrideCheck and argumentPart and argumentPart ~= "" then
            local foundPlayer, errorMsg = findPlayerByPartialName(argumentPart)
            if errorMsg then
                print("Stand Script: " .. errorMsg)
                return -- Stop processing if error finding player (not found or ambiguous)
            elseif foundPlayer then
                 if foundPlayer == LocalPlayer then
                     print("Stand Script: Cannot target self for command '" .. commandPart .. "'.")
                     return -- Don't execute if targeting self
                 end
                 targetPlayerOverride = foundPlayer -- Store the found player object
                 print("Stand Script: Resolved target to '"..foundPlayer.Name.."'")
            -- If foundPlayer and errorMsg are nil, something unexpected happened, fallback to default
            end
        end

        -- Call appropriate function
        if commandPart == GOTO_COMMAND then performTeleport(targetPlayerOverride)
        elseif commandPart == FOLLOW_COMMAND then startFollowing(targetPlayerOverride)
        elseif commandPart == FLY_COMMAND then startFlying(targetPlayerOverride)
        elseif commandPart == ORBIT_COMMAND then startOrbiting(targetPlayerOverride)
        elseif commandPart == UNFOLLOW_COMMAND then stopAllMovement()
        elseif commandPart == UNFLY_COMMAND then stopAllMovement()
        elseif commandPart == SPEED_COMMAND then performSetSpeed(argumentPart)
        elseif commandPart == JUMP_COMMAND then performJump()
        elseif commandPart == ANIMATE_COMMAND then performPlayAnimation(argumentPart)
        elseif commandPart == STOPANIM_COMMAND then performStopAnimation()
        elseif commandPart == RESET_COMMAND then performReset()
        elseif commandPart == REJOIN_COMMAND then performRejoin()
        elseif commandPart == FLING_COMMAND then performFlingCheck(argumentPart) -- Fling uses name directly
        end
    end
end

-- == Event Connections & Initialization ==
local function connectChat(player) if player.Name == TARGET_USERNAME then if not TargetPlayer then print("Target '"..TARGET_USERNAME.."' found."); TargetPlayer=player; player.Chatted:Connect(function(m) task.spawn(onPlayerChatted,player,m) end) else print("Re-establishing listener for "..TARGET_USERNAME); player.Chatted:Connect(function(m) task.spawn(onPlayerChatted,player,m) end) end end end
local function onCharacterAdded(character) print("Local character added/respawned."); stopAllMovement(); LocalCharacter=character; LocalHumanoid=character:WaitForChild("Humanoid"); LocalRootPart=character:WaitForChild("HumanoidRootPart"); LocalAnimator=LocalHumanoid and LocalHumanoid:FindFirstChild("Animator") or (LocalHumanoid and LocalHumanoid:WaitForChild("Animator")); isFollowing,isFlying,isOrbiting=false,false,false; bodyPos,bodyGyro,currentAnimTrack=nil,nil,nil; currentMovementTargetPlayer=nil; disableNoclip(character); if LocalHumanoid then LocalHumanoid.PlatformStand=false end; if LocalHumanoid then LocalHumanoid.Died:Connect(function() print("Local humanoid died.") end) end end
findDefaultTargetPlayer(); if TargetPlayer then connectChat(TargetPlayer) end
Players.PlayerAdded:Connect(function(p) if p.Name == TARGET_USERNAME then findDefaultTargetPlayer(); connectChat(p) end end)
Players.PlayerRemoving:Connect(function(p)
    if p and TargetPlayer and p == TargetPlayer then print("Default target left."); if currentMovementTargetPlayer==TargetPlayer then stopAllMovement() end; TargetPlayer=nil; end -- Stop if default target leaves AND they were the current move target. Clear TargetPlayer ref.
    if p and currentMovementTargetPlayer and p == currentMovementTargetPlayer then print("Current movement target left."); stopAllMovement() end -- Stop if specific move target leaves (this also clears currentMovementTargetPlayer)
end)
LocalPlayer.CharacterAdded:Connect(onCharacterAdded); if LocalPlayer.Character then onCharacterAdded(LocalPlayer.Character) end
if not movementConnection then movementConnection = RunService.Heartbeat:Connect(updateMovement); print("Movement update loop connected.") end
print("Stand Script Initialized for "..LocalPlayer.Name..". Listening for '"..TARGET_USERNAME.."'.")
