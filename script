local function startOrbiting(targetPlayerOverride) stopAllMovement(); local target=targetPlayerOverride or TargetPlayer; if not target then print("Orbit target not found."); return end; if isOrbiting and currentMovementTargetPlayer==target then print("Already orbiting "..target.Name); return end; local lc=LocalPlayer.Character; local lh=lc and lc:FindFirstChild("Humanoid"); local lr=lc and lc:FindFirstChild("HumanoidRootPart"); if not (lc and lh and lr) then print("Cannot orbit, local char missing."); return end; print("Orbiting "..target.Name); if createBodyMovers(true) then isOrbiting=true; currentMovementTargetPlayer=target; currentOrbitAngle=0 else print("Failed orbit movers."); stopAllMovement() end end
local function startBang(targetPlayerOverride) stopAllMovement(); local target=targetPlayerOverride or TargetPlayer; if not target then print("Bang target not found."); return end; if isBanging and currentBangTargetPlayer==target then print("Already banging "..target.Name); return end; local lc=LocalPlayer.Character; local lh=lc and lc:FindFirstChild("Humanoid"); local lr=lc and lc:FindFirstChild("HumanoidRootPart"); if not (lc and lh and lr) then print("Cannot bang, local char missing."); return end; print("Starting bang effect on "..target.Name); isBanging=true; currentBangTargetPlayer=target; playBangAnimation(); if LocalHumanoid then LocalHumanoid.PlatformStand=true end end
local function startSpin(speed) -- NEW
    stopAllMovement()
    local spinSpeed = tonumber(speed) or 20
