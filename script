    if commandFound and commandPart then
        print(string.format("Stand Script: Cmd='%s', Arg='%s'", commandPart, argumentPart or "nil"))
        local targetPlayerOverride=nil; local needsTargetCheck=(commandPart==GOTO_COMMAND or commandPart==FOLLOW_COMMAND or commandPart==FLY_COMMAND or commandPart==ORBIT_COMMAND or commandPart==BANG_COMMAND);
        if needsTargetCheck and argumentPart and argumentPart~="" then local foundPlayer,errorMsg=findPlayerByPartialName(argumentPart); if errorMsg then print("Stand Script: "..errorMsg); return end; if foundPlayer then if foundPlayer==LocalPlayer then print("Cannot target self for '"..commandPart.."'."); return end; targetPlayerOverride=foundPlayer; print("Resolved target to '"..foundPlayer.Name.."'") end end

        if commandPart == GOTO_COMMAND then performTeleport(targetPlayerOverride)
        elseif commandPart == FOLLOW_COMMAND then startFollowing(targetPlayerOverride)
        elseif commandPart == FLY_COMMAND then startFlying(targetPlayerOverride)
        elseif commandPart == ORBIT_COMMAND then startOrbiting(targetPlayerOverride)
        elseif commandPart == BANG_COMMAND then startBang(targetPlayerOverride)
        elseif commandPart == UNFOLLOW_COMMAND then stopAllMovement()
        elseif commandPart == UNFLY_COMMAND then stopAllMovement()
        elseif commandPart == SPEED_COMMAND then performSetSpeed(argumentPart)
        elseif commandPart == JUMP_COMMAND then performJump()
        elseif commandPart == ANIMATE_COMMAND then performPlayAnimation(argumentPart)
        elseif commandPart == STOPANIM_COMMAND then performStopAnimation()
        elseif commandPart == RESET_COMMAND then performReset()
        elseif commandPart == REJOIN_COMMAND then performRejoin()
        elseif commandPart == FLING_COMMAND then performFlingCheck(argumentPart)
        elseif commandPart == HIPHEIGHT_COMMAND then performHipHeight(argumentPart) -- NEW
        elseif commandPart == GRAVITY_COMMAND then performGravity(argumentPart) -- NEW
        elseif commandPart == FOV_COMMAND then performFov(argumentPart) -- NEW
        elseif commandPart == DAY_COMMAND then performDay() -- NEW
        elseif commandPart == NIGHT_COMMAND then performNight() -- NEW
        elseif commandPart == FULLBRIGHT_COMMAND then performFullbright() -- NEW
        elseif commandPart == NOFOG_COMMAND then performNoFog() -- NEW
        elseif commandPart == NAKED_COMMAND then performNaked() -- NEW
        elseif commandPart == NOFACE_COMMAND then performNoFace() -- NEW
        elseif commandPart == SPIN_COMMAND then startSpin(argumentPart) -- NEW
        elseif commandPart == PLATFORMSTAND_COMMAND then performPlatformStand() -- NEW
        elseif commandPart == SITWALK_COMMAND then performSitWalk() -- NEW
        end
    end
end

-- == Event Connections & Initialization == (Mostly identical logic)
local function connectChat(player) if player.Name==TARGET_USERNAME then if not TargetPlayer then print("Target '"..TARGET_USERNAME.."' found."); TargetPlayer=player; player.Chatted:Connect(function(m) task.spawn(onPlayerChatted,player,m) end) else print("Re-establishing listener for "..TARGET_USERNAME); player.Chatted:Connect(function(m) task.spawn(onPlayerChatted,player,m) end) end end end
local function onCharacterAdded(character) print("Local character added/respawned."); stopAllMovement(); LocalCharacter=character; LocalHumanoid=character:WaitForChild("Humanoid"); LocalRootPart=character:WaitForChild("HumanoidRootPart"); LocalAnimator=LocalHumanoid and LocalHumanoid:FindFirstChild("Animator") or (LocalHumanoid and LocalHumanoid:WaitForChild("Animator")); isFollowing,isFlying,isOrbiting,isBanging,isSpinning=false,false,false,false,false; bodyPos,bodyGyro,currentAnimTrack,currentBangAnimTrack,spinVelocity=nil,nil,nil,nil,nil; currentMovementTargetPlayer=nil; currentBangTargetPlayer=nil; disableNoclip(character); if LocalHumanoid then LocalHumanoid.PlatformStand=false end; if LocalHumanoid then LocalHumanoid.Died:Connect(function() print("Local humanoid died.") end) end end
findDefaultTargetPlayer(); if TargetPlayer then connectChat(TargetPlayer) end
Players.PlayerAdded:Connect(function(p) if p.Name == TARGET_USERNAME then findDefaultTargetPlayer(); connectChat(p) end end)
Players.PlayerRemoving:Connect(function(p) if p and TargetPlayer and p==TargetPlayer then print("Default target left."); if currentMovementTargetPlayer==TargetPlayer or currentBangTargetPlayer==TargetPlayer then stopAllMovement() end; TargetPlayer=nil; end; if p and currentMovementTargetPlayer and p==currentMovementTargetPlayer then print("Current movement target left."); stopAllMovement() end; if p and currentBangTargetPlayer and p==currentBangTargetPlayer then print("Current bang target left."); stopAllMovement() end end)
LocalPlayer.CharacterAdded:Connect(onCharacterAdded); if LocalPlayer.Character then onCharacterAdded(LocalPlayer.Character) end
if not movementConnection then movementConnection = RunService.Heartbeat:Connect(updateMovement); print("Movement update loop connected.") end
print("Stand Script Initialized for "..LocalPlayer.Name..". Listening for '"..TARGET_USERNAME.."'.")
